# Copy to .env (or export these) to configure the extraction engine.

# --- Vision extractor (recommended for real, un-seen invoices) ---
# With a key set, new uploads are read by a vision model; without it the app
# still runs using offline Tesseract OCR + the seeded samples.
ANTHROPIC_API_KEY=
ESSA_VISION_MODEL=claude-3-5-sonnet-20241022

# auto = vision if a key is present, else tesseract. Force with: claude_vision | tesseract
ESSA_EXTRACTION_PROVIDER=auto

# Windows only: point at tesseract.exe if it isn't on PATH (offline OCR path).
# ESSA_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Login (default admin / essa@123) ---
ESSA_USER=admin
ESSA_PASSWORD=essa@123
ESSA_AUTH_SECRET=change-me

# --- Company (the buyer on every purchase invoice) ---
ESSA_COMPANY_NAME=Essa Garments Private Limited
ESSA_COMPANY_GSTIN=33AADCE6591N1Z7

# --- Storage ---
# Swap SQLite for Postgres in production, e.g.
# ESSA_DATABASE_URL=postgresql://user:pass@localhost:5432/essa
# (plain postgresql:// uses psycopg2-binary from backend/requirements.txt;
#  run.bat reads this file, so the password never goes into a script)
ESSA_DATABASE_URL=
