backend/.venv/
backend/data/essa.db
backend/data/settings.json
backend/data/uploads/*
!backend/data/uploads/.gitkeep
frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
.env
.DS_Store

# Android build. `local.properties` holds a machine-specific SDK path, and the
# APK is a build product — GitHub Actions rebuilds it from source on demand
# (.github/workflows/android-apk.yml), so a copy here would only go stale.
android/build-output/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# The shop's own database, and the backups taken before anything destructive.
Textile Retail Shop/textile_shop.db
# SQLite's write-ahead log and its shared-memory index. They appear beside the
# database once WAL is on — which the shop turns on so two tills can bill at the
# same moment (see the shop's app/__init__._enable_concurrent_writes) — and they
# are working files of a running database, never source.
*.db-wal
*.db-shm
*.db.bak*

# The shop's virtualenvs. `backend/.venv/` is ignored above; these were missed
# when the shop was added, and `.venv-win` alone is 1,674 files and 55 MB of
# vendored packages. `.venv` happens to self-ignore (venv writes a `.gitignore`
# containing `*` into the directory it creates) — `.venv-win` predates that and
# does not, so both are named here rather than relying on that.
Textile Retail Shop/.venv/
Textile Retail Shop/.venv-win/

# Copies of a virtualenv moved aside rather than deleted (a venv built on another
# PC, kept in case it is needed), and the database snapshot taken before a bulk
# import (tools/import_old_items.py). Both are local-only.
backend/.venv*/
backend/data/*.db.before-*
