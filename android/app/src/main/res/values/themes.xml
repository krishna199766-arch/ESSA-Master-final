<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The warehouse app's own chrome — the dark forest green of its header — so
         the status bar doesn't sit at odds with the page it frames. The window
         behind the WebView is the page background, so loading never flashes. -->
    <style name="Theme.Essa" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#0B3D2E</item>
        <item name="colorPrimaryDark">#0B3D2E</item>
        <item name="colorAccent">#2F8F68</item>
        <item name="android:statusBarColor">#0B3D2E</item>
        <item name="android:windowBackground">#F7F9F7</item>
    </style>
</resources>
